# Production-Grade Agentic Orchestration System Environment Configuration

# Core Application Settings
APP_NAME="Agentic Orchestration Engine"
ENVIRONMENT="development" # Options: development, staging, production, test
DEBUG=true
LOG_LEVEL="INFO"          # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_JSON=true             # Set to true for structured JSON logging, false for human-readable

# Workflow & Quality Gate Settings
WORKFLOW_MAX_ITERATIONS=3
WORKFLOW_QUALITY_THRESHOLD=0.8

# Resilience & Retries Configuration
MOCK_MODE=true                # Set to true for offline deterministic execution without API keys
MAX_RETRIES=3                 # Max exponential backoff retries for transient errors
RETRY_BASE_DELAY=0.5          # Base backoff delay in seconds
RETRY_MAX_DELAY=5.0           # Max cap backoff delay in seconds
REQUEST_TIMEOUT_SECONDS=30.0  # Request timeout per operation in seconds

# LLM API Secrets (Optional when MOCK_MODE=true; NEVER commit real secrets to source control)
OPENAI_API_KEY="sk-placeholder-do-not-hardcode-real-keys"
ANTHROPIC_API_KEY="sk-placeholder-do-not-hardcode-real-keys"
